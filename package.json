{
  "name": "boltscribe",
  "version": "1.2.1",
  "description": "Local-first macOS and Windows voice input with ASR transcription, LLM correction, global hotkeys, and a Tauri tray workflow.",
  "private": true,
  "type": "module",
  "keywords": [
    "macos",
    "windows",
    "tauri",
    "react",
    "rust",
    "voice-input",
    "dictation",
    "speech-to-text",
    "asr",
    "llm",
    "openai-compatible",
    "menu-bar",
    "productivity"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "version:check": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.1",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@vitejs/plugin-react": "4.2.1",
    "typescript": "5.4.5",
    "vite": "5.2.14"
  }
}
