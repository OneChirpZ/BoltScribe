{
  "name": "boltscribe",
  "version": "1.6.0",
  "description": "Local-first macOS and Windows voice input with ASR transcription, LLM correction, global hotkeys, and a Tauri tray workflow.",
  "private": true,
  "type": "module",
  "keywords": [
    "macos",
    "windows",
    "tauri",
    "react",
    "rust",
    "voice-input",
    "dictation",
    "speech-to-text",
    "asr",
    "llm",
    "openai-compatible",
    "menu-bar",
    "productivity"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:macos-local": "node scripts/build-macos-local.mjs",
    "replace:macos-local": "node scripts/replace-macos-local.mjs",
    "release:macos": "node scripts/build-macos-release.mjs",
    "test:frontend": "npm run test:frontend:domain && npm run test:frontend:ui",
    "test:frontend:domain": "node --test tests/*.test.ts",
    "test:frontend:ui": "vitest run",
    "test:packaging": "node --test scripts/*.test.mjs",
    "tauri": "node scripts/run-tauri.mjs",
    "version:check": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.1",
    "@testing-library/react": "15.0.7",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@vitejs/plugin-react": "4.2.1",
    "jsdom": "24.1.0",
    "typescript": "5.4.5",
    "vite": "5.2.14",
    "vitest": "1.6.1"
  }
}
